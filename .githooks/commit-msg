#!/bin/sh
# Enable with: git config core.hooksPath .githooks
# A commit message is public once pushed: check it like any tracked file, and keep it semantic.
# CI=1 makes the checker use the example list only; a CI variable left in a developer's shell
# must not switch the real list off here (S0 judge round 4, E2)
unset CI
node scripts/check-forbidden.mjs --file "$1" || { echo "commit-msg: forbidden strings in the commit message"; exit 1; }
uv run --quiet --locked python scripts/check_conventions.py --message-file "$1" || { echo "commit-msg: use Conventional Commits, e.g. \"feat(retrieval): add BM25\""; exit 1; }
