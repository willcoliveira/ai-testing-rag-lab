#!/bin/sh
# Enable with: git config core.hooksPath .githooks
# Checks what is staged, not the working tree.
scripts/check-staged-privacy.sh || { echo "pre-commit: forbidden strings in the staged changes"; exit 1; }
gitleaks git --pre-commit --staged --redact --no-banner || { echo "pre-commit: gitleaks found a secret in the staged changes"; exit 1; }
uv run --quiet --locked ruff format --check || { echo "pre-commit: run 'uv run ruff format'"; exit 1; }
