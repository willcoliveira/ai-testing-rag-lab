#!/bin/sh
# Enable with: make hooks (required in every clone)
# Before a push: every commit message and every line added by the commits being pushed, so a
# string committed without the hooks, or committed and removed in a later commit, never leaves
# this clone. Git gives one line per ref on stdin: <local ref> <local id> <remote ref> <remote id>.
remote=$1
status=0
while read -r _ local_id _ remote_id; do
  # a deleted ref pushes no commits
  case $local_id in *[!0]*) ;; *) continue ;; esac
  case $remote_id in *[!0]*) known=yes ;; *) known=no ;; esac
  if [ "$known" = yes ] && git cat-file -e "$remote_id^{commit}" 2>/dev/null; then
    set -- "$remote_id..$local_id"
  else
    # a new branch, or a remote tip this clone has not fetched: every commit that no
    # remote-tracking ref of this remote has (all of them for a push to a URL)
    set -- "$local_id" --not --remotes="$remote"
  fi
  node scripts/check-forbidden.mjs --history "$@" </dev/null || status=1
done
[ "$status" -eq 0 ] || echo "pre-push: forbidden strings in the commits being pushed (see above)"
exit "$status"
