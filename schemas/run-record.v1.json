{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-record.v1.json",
  "title": "raglab run record v1",
  "description": "A run directory read as one object: manifest.json and every line of cases.jsonl. report.md is generated from both and checked by raglab.evals.record.validate, as are the sha256 of each file and the results recomputed from the cases. Validated by raglab.evals.schema, which supports a subset of JSON Schema and refuses any other keyword. S3 extends v1 additively with the generation suite: its manifest and case fields are optional here, and validate requires them for that suite and refuses them for retrieval, as it requires bootstrap and the retrieval case fields for retrieval (the subset has no conditional keywords).",
  "type": "object",
  "required": ["manifest", "cases"],
  "additionalProperties": false,
  "properties": {
    "manifest": {"$ref": "#/$defs/manifest"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {
      "type": "object",
      "required": ["value", "ci_low", "ci_high", "n"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number"},
        "ci_low": {"type": "number"},
        "ci_high": {"type": "number"},
        "n": {"type": "integer", "minimum": 1}
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema_version", "run_id", "created_at", "suite", "gate", "split", "trials", "seed",
        "provenance", "partial", "git_sha", "git_dirty", "config", "chunker", "embedder",
        "retriever", "dataset", "corpus", "tools", "results", "totals", "files"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "run-record.v1"},
        "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+-(dev|test|all)-[0-9a-f]{7}$"},
        "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "suite": {"enum": ["retrieval", "generation"]},
        "gate": {"enum": ["manual", "pr-fast", "eval-on-change", "nightly", "weekly", "release"]},
        "split": {"enum": ["dev", "test", "all"]},
        "trials": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "provenance": {"enum": ["fake", "local", "hosted"]},
        "partial": {"type": "boolean"},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_dirty": {"type": "boolean"},
        "config": {
          "type": "object",
          "required": ["name", "path", "file_sha256", "sha256"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "path": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "chunker": {
          "type": "object",
          "required": ["chunk_size", "overlap", "sha256"],
          "additionalProperties": false,
          "properties": {
            "chunk_size": {"type": "integer", "minimum": 1},
            "overlap": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "embedder": {
          "type": "object",
          "required": ["provider", "model", "revision", "dimension", "sha256"],
          "additionalProperties": {"type": ["string", "integer"]},
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "dimension": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "retriever": {
          "type": "object",
          "required": ["kind", "k", "sha256"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["dense", "bm25", "hybrid"]},
            "k": {"type": "integer", "minimum": 1},
            "candidates": {"type": "integer", "minimum": 1},
            "rrf_k": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "dataset": {
          "type": "object",
          "required": ["path", "sha256", "questions"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "questions": {"type": "integer", "minimum": 1}
          }
        },
        "corpus": {
          "type": "object",
          "required": ["documents", "chunks", "sha256"],
          "additionalProperties": false,
          "properties": {
            "documents": {"type": "integer", "minimum": 1},
            "chunks": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "tools": {
          "type": "object",
          "required": ["python", "raglab"],
          "additionalProperties": {"type": "string"},
          "properties": {
            "python": {"type": "string"},
            "raglab": {"type": "string"}
          }
        },
        "bootstrap": {
          "type": "object",
          "required": ["resamples", "seed", "level", "method"],
          "additionalProperties": false,
          "properties": {
            "resamples": {"type": "integer", "minimum": 1},
            "seed": {"type": "integer"},
            "level": {"type": "number", "minimum": 0, "maximum": 1},
            "method": {"const": "percentile"}
          }
        },
        "results": {
          "type": "object",
          "required": ["metrics"],
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/interval"}
            },
            "generation": {"$ref": "#/$defs/generation_results"}
          }
        },
        "totals": {
          "type": "object",
          "required": ["cases", "duration_s"],
          "additionalProperties": false,
          "properties": {
            "cases": {"type": "integer", "minimum": 1},
            "duration_s": {"type": "number", "minimum": 0},
            "stopped": {"type": "string", "minLength": 1}
          }
        },
        "generator": {
          "type": "object",
          "required": ["provider", "model", "digest", "sha256"],
          "additionalProperties": false,
          "properties": {
            "provider": {"enum": ["fake", "openai-compat"]},
            "model": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "minLength": 1},
            "base_url": {"type": "string", "minLength": 1},
            "server_version": {"type": "string", "minLength": 1},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "max_tokens": {"type": "integer", "minimum": 1},
            "timeout_s": {"type": "number", "minimum": 0},
            "extra": {"type": "object", "additionalProperties": {"type": "string"}},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "prompt": {
          "type": "object",
          "required": ["version", "sha256"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "guards": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "intervals": {
          "type": "object",
          "required": ["method", "level", "unit"],
          "additionalProperties": false,
          "properties": {
            "method": {"const": "wilson"},
            "level": {"type": "number", "minimum": 0, "maximum": 1},
            "unit": {"const": "case"}
          }
        },
        "probes": {
          "type": "object",
          "required": ["path", "sha256", "questions"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "questions": {"type": "integer", "minimum": 0}
          }
        },
        "ollama": {
          "type": "object",
          "required": ["host", "keep_alive", "max_loaded_models", "num_parallel", "context_length"],
          "additionalProperties": false,
          "properties": {
            "host": {"type": "string", "pattern": "^(127\\.0\\.0\\.1|localhost):[0-9]{1,5}$"},
            "keep_alive": {"type": "string", "minLength": 1},
            "max_loaded_models": {"type": "integer", "minimum": 1},
            "num_parallel": {"type": "integer", "minimum": 1},
            "context_length": {"type": "integer", "minimum": 1}
          }
        },
        "files": {
          "type": "object",
          "required": ["cases.jsonl", "report.md"],
          "additionalProperties": false,
          "properties": {
            "cases.jsonl": {"$ref": "#/$defs/sha256"},
            "report.md": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["case_id", "trial", "split", "tenant", "question", "retrieved", "latency_ms"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "trial": {"type": "integer", "minimum": 1},
        "split": {"enum": ["dev", "test"]},
        "tenant": {"enum": ["tenant-a", "tenant-b"]},
        "question": {"type": "string", "minLength": 1},
        "question_kind": {"type": "string"},
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["doc_id", "section_id", "chunk_ids", "found"],
            "additionalProperties": false,
            "properties": {
              "doc_id": {"type": "string", "minLength": 1},
              "section_id": {"type": "string", "minLength": 1},
              "chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "found": {"type": "boolean"}
            }
          }
        },
        "retrieved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rank", "chunk_id", "score", "relevant"],
            "additionalProperties": false,
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "chunk_id": {"type": "string", "minLength": 1},
              "score": {"type": "number"},
              "relevant": {"type": "boolean"}
            }
          }
        },
        "hit": {"type": "integer", "enum": [0, 1]},
        "reciprocal_rank": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_ms": {"type": "number", "minimum": 0},
        "kind": {"enum": ["retrieval", "probe"]},
        "feature_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]+$"}},
        "expected": {"enum": ["answer", "abstain", "flag-conflict", "refuse-and-help"]},
        "must_not_appear": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["ok", "refused", "blocked", "unavailable", "invalid_output"]},
        "label": {"enum": ["answer", "abstain", "flag-conflict", "refuse-and-help"]},
        "answer": {"type": "string"},
        "cited_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conflict": {
          "type": ["object", "null"],
          "required": ["chunk_ids", "note"],
          "additionalProperties": false,
          "properties": {
            "chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "note": {"type": "string"}
          }
        },
        "guard_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["guard", "stage", "reason"],
            "additionalProperties": false,
            "properties": {
              "guard": {"type": "string", "minLength": 1},
              "stage": {"enum": ["input", "retrieved", "output"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "error": {"type": ["string", "null"]},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "checks": {
          "type": "object",
          "required": ["status_ok", "citations_retrieved", "passed"],
          "additionalProperties": false,
          "properties": {
            "status_ok": {"type": "boolean"},
            "citations_retrieved": {"type": "boolean"},
            "abstained": {"type": "boolean"},
            "forbidden_absent": {"type": "boolean"},
            "answered": {"type": "boolean"},
            "cites_label": {"type": "boolean"},
            "passed": {"type": "boolean"}
          }
        }
      }
    },
    "count": {"type": "integer", "minimum": 0},
    "generation_results": {
      "type": "object",
      "required": [
        "trials", "cases", "case_trials", "status_counts", "label_agreement", "probes",
        "latency_ms", "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "trials": {"type": "integer", "minimum": 1},
        "cases": {"type": "integer", "minimum": 1},
        "case_trials": {"type": "integer", "minimum": 1},
        "status_counts": {
          "type": "object",
          "required": ["ok", "refused", "blocked", "unavailable", "invalid_output"],
          "additionalProperties": false,
          "properties": {
            "ok": {"$ref": "#/$defs/count"},
            "refused": {"$ref": "#/$defs/count"},
            "blocked": {"$ref": "#/$defs/count"},
            "unavailable": {"$ref": "#/$defs/count"},
            "invalid_output": {"$ref": "#/$defs/count"}
          }
        },
        "label_agreement": {
          "type": "object",
          "required": ["cases", "unanimous"],
          "additionalProperties": false,
          "properties": {
            "cases": {"$ref": "#/$defs/count"},
            "unanimous": {"$ref": "#/$defs/count"}
          }
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "feature_ids", "tenant", "abstained", "trials"],
            "additionalProperties": false,
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "feature_ids": {"type": "array", "items": {"type": "string"}},
              "tenant": {"enum": ["tenant-a", "tenant-b"]},
              "abstained": {"$ref": "#/$defs/count"},
              "trials": {"type": "integer", "minimum": 1}
            }
          }
        },
        "latency_ms": {
          "type": "object",
          "required": ["p50", "p95", "n"],
          "additionalProperties": false,
          "properties": {
            "p50": {"type": "number", "minimum": 0},
            "p95": {"type": "number", "minimum": 0},
            "n": {"type": "integer", "minimum": 1}
          }
        },
        "tokens": {
          "type": "object",
          "required": ["reported", "prompt", "completion"],
          "additionalProperties": false,
          "properties": {
            "reported": {"$ref": "#/$defs/count"},
            "prompt": {"$ref": "#/$defs/count"},
            "completion": {"$ref": "#/$defs/count"}
          }
        }
      }
    }
  }
}
