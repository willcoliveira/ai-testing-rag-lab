{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-record.v1.json",
  "title": "raglab run record v1",
  "description": "A run directory read as one object: manifest.json and every line of cases.jsonl. report.md is generated from both and checked by raglab.evals.record.validate, as are the sha256 of each file and the results recomputed from the cases. Validated by raglab.evals.schema, which supports a subset of JSON Schema and refuses any other keyword. S3 extends v1 additively with the generation suite: its manifest and case fields are optional here, and validate requires them for that suite and refuses them for retrieval, as it requires bootstrap and the retrieval case fields for retrieval (the subset has no conditional keywords). S4 extends v1 additively again: the behaviour case kind (expected, mix and feature_ids; labels and scores unless it abstains, a label's side on a flag-conflict case, may_quote on an abstain case), label groups (any_of), the checks decision_label, conflict and must_not_contain, and results.generation.behaviour; the probes block is required only of a run with probe cases. S5 extends v1 additively again: the judged suite (the judge, its prompt, the source run, the criteria and canary set with the canary results, and results.judged in the manifest; each line's source fields, reference sha256, verdicts and the repeatability and order checks), and the position case kind; validate requires them for that suite and refuses them elsewhere. S7 extends v1 additively again: a generation manifest's guard_set (each layer's name and the sha256 of its rules, and one sha256 over the list), which the staleness rule reads. Every earlier record validates as it did.",
  "type": "object",
  "required": ["manifest", "cases"],
  "additionalProperties": false,
  "properties": {
    "manifest": {"$ref": "#/$defs/manifest"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {
      "type": "object",
      "required": ["value", "ci_low", "ci_high", "n"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number"},
        "ci_low": {"type": "number"},
        "ci_high": {"type": "number"},
        "n": {"type": "integer", "minimum": 1}
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema_version", "run_id", "created_at", "suite", "gate", "split", "trials", "seed",
        "provenance", "partial", "git_sha", "git_dirty", "config", "chunker", "embedder",
        "retriever", "dataset", "corpus", "tools", "results", "totals", "files"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "run-record.v1"},
        "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+-(dev|test|all)-[0-9a-f]{7}$"},
        "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "suite": {"enum": ["retrieval", "generation", "judged"]},
        "gate": {"enum": ["manual", "pr-fast", "eval-on-change", "nightly", "weekly", "release"]},
        "split": {"enum": ["dev", "test", "all"]},
        "trials": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "provenance": {"enum": ["fake", "local", "hosted"]},
        "partial": {"type": "boolean"},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_dirty": {"type": "boolean"},
        "config": {
          "type": "object",
          "required": ["name", "path", "file_sha256", "sha256"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "path": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "chunker": {
          "type": "object",
          "required": ["chunk_size", "overlap", "sha256"],
          "additionalProperties": false,
          "properties": {
            "chunk_size": {"type": "integer", "minimum": 1},
            "overlap": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "embedder": {
          "type": "object",
          "required": ["provider", "model", "revision", "dimension", "sha256"],
          "additionalProperties": {"type": ["string", "integer"]},
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "dimension": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "retriever": {
          "type": "object",
          "required": ["kind", "k", "sha256"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["dense", "bm25", "hybrid"]},
            "k": {"type": "integer", "minimum": 1},
            "candidates": {"type": "integer", "minimum": 1},
            "rrf_k": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "dataset": {
          "type": "object",
          "required": ["path", "sha256", "questions"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "questions": {"type": "integer", "minimum": 1}
          }
        },
        "corpus": {
          "type": "object",
          "required": ["documents", "chunks", "sha256"],
          "additionalProperties": false,
          "properties": {
            "documents": {"type": "integer", "minimum": 1},
            "chunks": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "tools": {
          "type": "object",
          "required": ["python", "raglab"],
          "additionalProperties": {"type": "string"},
          "properties": {
            "python": {"type": "string"},
            "raglab": {"type": "string"}
          }
        },
        "bootstrap": {
          "type": "object",
          "required": ["resamples", "seed", "level", "method"],
          "additionalProperties": false,
          "properties": {
            "resamples": {"type": "integer", "minimum": 1},
            "seed": {"type": "integer"},
            "level": {"type": "number", "minimum": 0, "maximum": 1},
            "method": {"const": "percentile"}
          }
        },
        "results": {
          "type": "object",
          "required": ["metrics"],
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/interval"}
            },
            "generation": {"$ref": "#/$defs/generation_results"},
            "judged": {"$ref": "#/$defs/judged_results"}
          }
        },
        "totals": {
          "type": "object",
          "required": ["cases", "duration_s"],
          "additionalProperties": false,
          "properties": {
            "cases": {"type": "integer", "minimum": 1},
            "duration_s": {"type": "number", "minimum": 0},
            "stopped": {"type": "string", "minLength": 1}
          }
        },
        "generator": {
          "type": "object",
          "required": ["provider", "model", "digest", "sha256"],
          "additionalProperties": false,
          "properties": {
            "provider": {"enum": ["fake", "openai-compat"]},
            "model": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "minLength": 1},
            "base_url": {"type": "string", "minLength": 1},
            "server_version": {"type": "string", "minLength": 1},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "top_p": {"type": "number", "minimum": 0, "maximum": 1},
            "max_tokens": {"type": "integer", "minimum": 1},
            "timeout_s": {"type": "number", "minimum": 0},
            "response_format": {"enum": ["json_schema", "none"]},
            "extra": {"type": "object", "additionalProperties": {"type": "string"}},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "prompt": {
          "type": "object",
          "required": ["version", "sha256"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "position": {
          "$comment": "S5, the position test's generation run: its cases, positions, prompt budget, the measured characters per token and the bootstrap's resamples and seed",
          "type": "object",
          "required": ["cases", "positions", "prompt_budget_tokens", "chars_per_token", "resamples", "seed"],
          "additionalProperties": false,
          "properties": {
            "cases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "positions": {"type": "array", "minItems": 1, "items": {"enum": ["first", "middle", "last"]}},
            "prompt_budget_tokens": {"type": "integer", "minimum": 1},
            "chars_per_token": {"type": "number", "minimum": 0},
            "resamples": {"type": "integer", "minimum": 1},
            "seed": {"type": "integer"}
          }
        },
        "judge": {
          "$comment": "S5, a judged run: the judge model, as the generator's block describes a generator",
          "type": "object",
          "required": ["provider", "model", "digest", "sha256"],
          "additionalProperties": false,
          "properties": {
            "provider": {"enum": ["fake", "openai-compat"]},
            "model": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "minLength": 1},
            "base_url": {"type": "string", "minLength": 1},
            "server_version": {"type": "string", "minLength": 1},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "top_p": {"type": "number", "minimum": 0, "maximum": 1},
            "max_tokens": {"type": "integer", "minimum": 1},
            "timeout_s": {"type": "number", "minimum": 0},
            "response_format": {"enum": ["json_schema", "none"]},
            "extra": {"type": "object", "additionalProperties": {"type": "string"}},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "judge_prompt": {
          "type": "object",
          "required": ["version", "sha256"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "source": {
          "$comment": "S5, a judged run: the generation run it judges, by id and its manifest's sha256",
          "type": "object",
          "required": ["run_id", "suite", "manifest_sha256"],
          "additionalProperties": false,
          "properties": {
            "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+-(dev|test|all)-[0-9a-f]{7}$"},
            "suite": {"enum": ["generation"]},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "criteria": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "canaries": {
          "type": "object",
          "required": ["path", "sha256", "results"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "results": {"type": "array", "items": {"$ref": "#/$defs/canary_result"}}
          }
        },
        "guards": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "guard_set": {
          "type": "object",
          "required": ["layers", "sha256"],
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "sha256"],
                "additionalProperties": false,
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "sha256": {"$ref": "#/$defs/sha256"}
                }
              }
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "intervals": {
          "type": "object",
          "required": ["method", "level", "unit"],
          "additionalProperties": false,
          "properties": {
            "method": {"const": "wilson"},
            "level": {"type": "number", "minimum": 0, "maximum": 1},
            "unit": {"const": "case"}
          }
        },
        "probes": {
          "type": "object",
          "required": ["path", "sha256", "questions"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "questions": {"type": "integer", "minimum": 0}
          }
        },
        "ollama": {
          "type": "object",
          "required": ["host", "keep_alive", "max_loaded_models", "num_parallel", "context_length"],
          "additionalProperties": false,
          "properties": {
            "host": {"type": "string", "pattern": "^(127\\.0\\.0\\.1|localhost):[0-9]{1,5}$"},
            "keep_alive": {"type": "string", "minLength": 1},
            "max_loaded_models": {"type": "integer", "minimum": 1},
            "num_parallel": {"type": "integer", "minimum": 1},
            "context_length": {"type": "integer", "minimum": 1}
          }
        },
        "files": {
          "type": "object",
          "required": ["cases.jsonl", "report.md"],
          "additionalProperties": false,
          "properties": {
            "cases.jsonl": {"$ref": "#/$defs/sha256"},
            "report.md": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["case_id", "trial", "split", "tenant", "question", "retrieved", "latency_ms"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "trial": {"type": "integer", "minimum": 1},
        "split": {"enum": ["dev", "test"]},
        "tenant": {"enum": ["tenant-a", "tenant-b"]},
        "question": {"type": "string", "minLength": 1},
        "question_kind": {"type": "string"},
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["doc_id", "section_id", "chunk_ids", "found"],
            "additionalProperties": false,
            "properties": {
              "doc_id": {"type": "string", "minLength": 1},
              "section_id": {"type": "string", "minLength": 1},
              "chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "found": {"type": "boolean"},
              "any_of": {
                "$comment": "S4: a label group, sections that state the same rule; one thing to find. doc_id and section_id are the first member's, chunk_ids every member's chunks together (validate checks both).",
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["doc_id", "section_id", "chunk_ids"],
                  "additionalProperties": false,
                  "properties": {
                    "doc_id": {"type": "string", "minLength": 1},
                    "section_id": {"type": "string", "minLength": 1},
                    "chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                  }
                }
              },
              "side": {
                "$comment": "S4, a flag-conflict behaviour case: the governing side of its conflict, or the superseded or external side (corpus/answer-key.yaml).",
                "enum": ["governing", "conflict"]
              }
            }
          }
        },
        "retrieved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rank", "chunk_id", "score", "relevant"],
            "additionalProperties": false,
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "chunk_id": {"type": "string", "minLength": 1},
              "score": {"type": "number"},
              "relevant": {"type": "boolean"}
            }
          }
        },
        "hit": {"type": "integer", "enum": [0, 1]},
        "reciprocal_rank": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_ms": {"type": "number", "minimum": 0},
        "kind": {"enum": ["retrieval", "probe", "behaviour", "position"]},
        "golden_id": {
          "$comment": "S5, a position case: the golden case it is built on (its case_id names the position too)",
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$comment": "S5, a position case: where the answering chunk sits in the context",
          "enum": ["first", "middle", "last"]
        },
        "answering_chunk": {"type": "string", "minLength": 1},
        "fillers": {"type": "integer", "minimum": 0},
        "source_status": {
          "$comment": "S5, a judged line: its source line's status",
          "enum": ["ok", "refused", "blocked", "unavailable", "invalid_output"]
        },
        "answer_sha256": {"$ref": "#/$defs/sha256"},
        "source_called": {"type": "boolean"},
        "source_tokens": {
          "type": "object",
          "required": ["prompt", "completion"],
          "additionalProperties": false,
          "properties": {
            "prompt": {"type": ["integer", "null"], "minimum": 0},
            "completion": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "reference_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "verdicts": {"$ref": "#/$defs/verdicts"},
        "repeat": {"$ref": "#/$defs/verdicts"},
        "reversed": {"$ref": "#/$defs/verdicts"},
        "feature_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]+$"}},
        "expected": {"enum": ["answer", "abstain", "flag-conflict", "refuse-and-help"]},
        "mix": {
          "$comment": "S4, a behaviour case: the build project's mix kind",
          "enum": ["single-chunk", "multi-chunk", "unanswerable", "version-conflict", "paraphrase", "misspelling"]
        },
        "may_quote": {
          "$comment": "S4, an abstain behaviour case: the shared reference section whose value the answer may quote (D-03), its chunks and the values each states (numbers only, never chunk text)",
          "type": "object",
          "required": ["doc_id", "section_id", "chunks"],
          "additionalProperties": false,
          "properties": {
            "doc_id": {"type": "string", "minLength": 1},
            "section_id": {"type": "string", "minLength": 1},
            "chunks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["chunk_id", "values"],
                "additionalProperties": false,
                "properties": {
                  "chunk_id": {"type": "string", "minLength": 1},
                  "values": {"type": "array", "items": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        },
        "canaries_of": {"enum": ["tenant-a", "tenant-b", null]},
        "status": {"enum": ["ok", "refused", "blocked", "unavailable", "invalid_output"]},
        "label": {"enum": ["answer", "abstain", "flag-conflict", "refuse-and-help"]},
        "answer": {"type": "string"},
        "cited_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conflict": {
          "type": ["object", "null"],
          "required": ["chunk_ids", "note"],
          "additionalProperties": false,
          "properties": {
            "chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "note": {"type": "string"}
          }
        },
        "guard_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["guard", "stage", "reason"],
            "additionalProperties": false,
            "properties": {
              "guard": {"type": "string", "minLength": 1},
              "stage": {"enum": ["input", "retrieved", "output"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "error": {"type": ["string", "null"]},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "checks": {
          "type": "object",
          "required": ["status_ok", "model_citations_retrieved", "passed"],
          "additionalProperties": false,
          "properties": {
            "status_ok": {"type": "boolean"},
            "model_citations_retrieved": {"type": "boolean"},
            "abstained": {"type": "boolean"},
            "no_value": {"type": "boolean"},
            "no_canary": {"type": "boolean"},
            "answered": {"type": "boolean"},
            "cites_label": {"type": "boolean"},
            "decision_label": {"type": "boolean"},
            "conflict": {"type": "boolean"},
            "must_not_contain": {"type": "boolean"},
            "cites_answering": {"type": "boolean"},
            "states_value": {"type": "boolean"},
            "passed": {"type": "boolean"}
          }
        }
      }
    },
    "count": {"type": "integer", "minimum": 0},
    "verdict": {
      "$comment": "S5: one judge call's verdict, what it rests on, the reply as it came, and what it cost; never a passage's text",
      "type": "object",
      "required": [
        "verdict", "status", "answer_quote", "quote_found", "passage_ids", "passages_given",
        "shown_ids", "reason", "reply", "prompt_tokens", "completion_tokens", "latency_ms", "error"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["pass", "fail", "unable_to_verify"]},
        "status": {"enum": ["ok", "invalid_output", "unavailable"]},
        "answer_quote": {"type": "string"},
        "quote_found": {"type": ["boolean", "null"]},
        "passage_ids": {"type": "array", "items": {"type": "string"}},
        "passages_given": {"type": "boolean"},
        "shown_ids": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"},
        "reply": {"type": ["string", "null"]},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0},
        "error": {"type": ["string", "null"]}
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/verdict"}
    },
    "canary_result": {
      "type": "object",
      "required": [
        "id", "criterion", "side", "on_side", "verdict", "status", "answer_quote", "quote_found",
        "passage_ids", "passages_given", "shown_ids", "reason", "reply", "prompt_tokens",
        "completion_tokens", "latency_ms", "error"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "criterion": {"enum": ["grounded", "cites_support", "correct", "relevant", "abstains", "refuses_and_helps", "context_sufficient"]},
        "side": {"enum": ["pass", "fail"]},
        "on_side": {"type": "boolean"},
        "verdict": {"enum": ["pass", "fail", "unable_to_verify"]},
        "status": {"enum": ["ok", "invalid_output", "unavailable"]},
        "answer_quote": {"type": "string"},
        "quote_found": {"type": ["boolean", "null"]},
        "passage_ids": {"type": "array", "items": {"type": "string"}},
        "passages_given": {"type": "boolean"},
        "shown_ids": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"},
        "reply": {"type": ["string", "null"]},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0},
        "error": {"type": ["string", "null"]}
      }
    },
    "role_tokens": {
      "type": "object",
      "required": ["calls", "prompt", "completion", "unreported"],
      "additionalProperties": false,
      "properties": {
        "calls": {"$ref": "#/$defs/count"},
        "prompt": {"$ref": "#/$defs/count"},
        "completion": {"$ref": "#/$defs/count"},
        "unreported": {"$ref": "#/$defs/count"}
      }
    },
    "agreement": {
      "type": "object",
      "required": ["pairs", "agree"],
      "additionalProperties": false,
      "properties": {
        "pairs": {"$ref": "#/$defs/count"},
        "agree": {"$ref": "#/$defs/count"}
      }
    },
    "judged_results": {
      "$comment": "S5: a judged run's counts per criterion, the checks on the judge, the canaries, the tokens by role and the judge calls' latency (raglab.evals.judged_record)",
      "type": "object",
      "required": [
        "cases", "case_trials", "criteria", "repeatability", "order", "canaries", "tokens",
        "latency_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "cases": {"type": "integer", "minimum": 1},
        "case_trials": {"type": "integer", "minimum": 1},
        "criteria": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": ["integer", "number", "null"], "minimum": 0}
          }
        },
        "repeatability": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/agreement"}
        },
        "order": {"$ref": "#/$defs/agreement"},
        "canaries": {
          "type": "object",
          "required": ["items", "on_side"],
          "additionalProperties": false,
          "properties": {
            "items": {"$ref": "#/$defs/count"},
            "on_side": {"$ref": "#/$defs/count"}
          }
        },
        "tokens": {
          "type": "object",
          "required": ["generator", "judge", "judge_checks", "canaries"],
          "additionalProperties": false,
          "properties": {
            "generator": {"$ref": "#/$defs/role_tokens"},
            "judge": {"$ref": "#/$defs/role_tokens"},
            "judge_checks": {"$ref": "#/$defs/role_tokens"},
            "canaries": {"$ref": "#/$defs/role_tokens"}
          }
        },
        "latency_ms": {
          "type": "object",
          "required": ["p50", "p95", "n"],
          "additionalProperties": false,
          "properties": {
            "p50": {"type": "number", "minimum": 0},
            "p95": {"type": "number", "minimum": 0},
            "n": {"$ref": "#/$defs/count"}
          }
        }
      }
    },
    "generation_results": {
      "type": "object",
      "required": [
        "trials", "cases", "case_trials", "status_counts", "label_agreement", "probes",
        "latency_ms", "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "trials": {"type": "integer", "minimum": 1},
        "cases": {"type": "integer", "minimum": 1},
        "case_trials": {"type": "integer", "minimum": 1},
        "status_counts": {
          "type": "object",
          "required": ["ok", "refused", "blocked", "unavailable", "invalid_output"],
          "additionalProperties": false,
          "properties": {
            "ok": {"$ref": "#/$defs/count"},
            "refused": {"$ref": "#/$defs/count"},
            "blocked": {"$ref": "#/$defs/count"},
            "unavailable": {"$ref": "#/$defs/count"},
            "invalid_output": {"$ref": "#/$defs/count"}
          }
        },
        "label_agreement": {
          "type": "object",
          "required": ["cases", "unanimous"],
          "additionalProperties": false,
          "properties": {
            "cases": {"$ref": "#/$defs/count"},
            "unanimous": {"$ref": "#/$defs/count"}
          }
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "feature_ids", "tenant", "abstained", "trials"],
            "additionalProperties": false,
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "feature_ids": {"type": "array", "items": {"type": "string"}},
              "tenant": {"enum": ["tenant-a", "tenant-b"]},
              "abstained": {"$ref": "#/$defs/count"},
              "trials": {"type": "integer", "minimum": 1}
            }
          }
        },
        "latency_ms": {
          "type": "object",
          "required": ["p50", "p95", "n"],
          "additionalProperties": false,
          "properties": {
            "p50": {"type": "number", "minimum": 0},
            "p95": {"type": "number", "minimum": 0},
            "n": {"type": "integer", "minimum": 1}
          }
        },
        "tokens": {
          "type": "object",
          "required": ["reported", "prompt", "completion"],
          "additionalProperties": false,
          "properties": {
            "reported": {"$ref": "#/$defs/count"},
            "prompt": {"$ref": "#/$defs/count"},
            "completion": {"$ref": "#/$defs/count"}
          }
        },
        "behaviour": {"$ref": "#/$defs/behaviour_results"}
      }
    },
    "label_counts": {
      "type": "object",
      "required": ["answer", "abstain", "flag-conflict", "refuse-and-help", "withheld"],
      "additionalProperties": false,
      "properties": {
        "answer": {"$ref": "#/$defs/count"},
        "abstain": {"$ref": "#/$defs/count"},
        "flag-conflict": {"$ref": "#/$defs/count"},
        "refuse-and-help": {"$ref": "#/$defs/count"},
        "withheld": {"$ref": "#/$defs/count"}
      }
    },
    "behaviour_results": {
      "$comment": "S4: the behaviour cases of a generation run (raglab.evals.behaviour), in case-trials unless named cases",
      "type": "object",
      "required": [
        "cases", "confusion", "abstention", "label_agreement", "label_failures",
        "conflict_side_missed"
      ],
      "additionalProperties": false,
      "properties": {
        "cases": {"type": "integer", "minimum": 1},
        "confusion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "answer": {"$ref": "#/$defs/label_counts"},
            "abstain": {"$ref": "#/$defs/label_counts"},
            "flag-conflict": {"$ref": "#/$defs/label_counts"},
            "refuse-and-help": {"$ref": "#/$defs/label_counts"}
          }
        },
        "abstention": {
          "type": "object",
          "required": [
            "abstain_no_value", "abstain_value", "not_abstain_no_value", "not_abstain_value"
          ],
          "additionalProperties": false,
          "properties": {
            "abstain_no_value": {"$ref": "#/$defs/count"},
            "abstain_value": {"$ref": "#/$defs/count"},
            "not_abstain_no_value": {"$ref": "#/$defs/count"},
            "not_abstain_value": {"$ref": "#/$defs/count"}
          }
        },
        "label_agreement": {
          "type": "object",
          "required": ["cases", "unanimous"],
          "additionalProperties": false,
          "properties": {
            "cases": {"$ref": "#/$defs/count"},
            "unanimous": {"$ref": "#/$defs/count"}
          }
        },
        "label_failures": {
          "type": "object",
          "required": ["labels_retrieved", "labels_missed", "no_labels"],
          "additionalProperties": false,
          "properties": {
            "labels_retrieved": {"$ref": "#/$defs/count"},
            "labels_missed": {"$ref": "#/$defs/count"},
            "no_labels": {"$ref": "#/$defs/count"}
          }
        },
        "conflict_side_missed": {"$ref": "#/$defs/count"}
      }
    }
  }
}
